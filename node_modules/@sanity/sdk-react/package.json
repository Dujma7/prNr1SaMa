{
  "name": "@sanity/sdk-react",
  "version": "3.0.0",
  "private": false,
  "description": "Sanity SDK React toolkit for Content OS",
  "keywords": [
    "cms",
    "content",
    "content operating system",
    "headless",
    "realtime",
    "sanity",
    "sdk"
  ],
  "homepage": "https://github.com/sanity-io/sdk/tree/main/packages/react/README.md",
  "bugs": {
    "url": "https://github.com/sanity-io/sdk/issues"
  },
  "license": "MIT",
  "author": "Sanity <developers@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/sdk.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./dashboard": "./dist/_exports/dashboard.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/message-protocol": "^0.24.0",
    "@sanity/types": "^6.9.1",
    "@sanity/workbench": "0.1.0-alpha.24",
    "groq": "3.88.1-typegen-experimental.0",
    "react-compiler-runtime": "^1.0.0",
    "react-error-boundary": "^6.1.2",
    "rxjs": "^7.8.2",
    "xstate": "^5.31.0",
    "@sanity/sdk": "3.0.0"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/comlink": "^4.0.3",
    "@sanity/pkg-utils": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "groq-js": "^2.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.58.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rolldown": "^1.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "@repo/config-eslint": "0.0.0",
    "@repo/package.config": "0.0.1",
    "@repo/package.bundle": "3.82.0",
    "@repo/tsconfig": "0.0.1",
    "@repo/config-test": "0.0.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "inlinedDependencies": {
    "@sanity/comlink": "4.0.3"
  },
  "scripts": {
    "build": "pkg build --strict --clean --check",
    "build:bundle": "vite build --configLoader runner --config package.bundle.ts",
    "clean": "rimraf dist",
    "dev": "pkg watch",
    "docs": "typedoc --json docs/typedoc.json --tsconfig ./tsconfig.dist.json",
    "format": "oxfmt",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ts:check": "tsc --noEmit"
  }
}